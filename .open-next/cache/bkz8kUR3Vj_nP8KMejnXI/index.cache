ext/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-full flex flex-col bg-zinc-50 text-zinc-900 selection:bg-zinc-900 selection:text-white\"><div hidden=\"\"><!--$--><!--/$--></div><div class=\"min-h-screen bg-[#fafafa] font-sans text-zinc-900 selection:bg-zinc-900 selection:text-white\"><main class=\"container mx-auto px-6 py-12 md:py-24\"><header class=\"text-center mb-24\"><div class=\"inline-flex items-center gap-2 mb-6 px-4 py-1.5 border border-zinc-200 text-zinc-600 rounded-full font-medium text-xs tracking-widest uppercase bg-white shadow-sm\"><span class=\"w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse\"></span>Live Competitions</div><h1 class=\"text-5xl md:text-7xl lg:text-8xl font-serif font-medium mb-8 text-zinc-950 tracking-tight leading-[1.1]\">The Great <br class=\"hidden md:block\"/><span class=\"italic text-zinc-500\">British</span> Draw.</h1><p class=\"text-lg md:text-xl text-zinc-600 mb-12 max-w-2xl mx-auto font-light leading-relaxed\">Premium competitions with guaranteed winners. The next draw takes place on the last day of the month at 10am.</p><div class=\"max-w-md mx-auto p-8 bg-white border border-zinc-200 rounded-2xl shadow-sm\"><h3 class=\"text-xs font-semibold mb-6 uppercase tracking-widest text-zinc-400\">Time remaining</h3><div class=\"text-zinc-900\"><div class=\"h-24 w-full animate-pulse bg-white/20 rounded-xl\"></div></div><p class=\"mt-6 text-xs text-zinc-500 font-medium\">Winnings transferred the next working day.</p></div></header><div class=\"grid md:grid-cols-2 gap-6 max-w-5xl mx-auto\"><div class=\"bg-white rounded-2xl p-8 md:p-10 border border-zinc-200 shadow-sm relative group hover:border-zinc-300 transition-colors\"><div class=\"absolute top-8 right-8 text-[10px] font-bold uppercase tracking-widest text-zinc-900 bg-zinc-100 px-3 py-1 rounded-full\">Standard</div><h2 class=\"text-2xl font-serif mb-2 text-zinc-900\">Monthly Draw</h2><div class=\"text-5xl font-light tracking-tight mb-8 text-zinc-950\">£10,000</div><div class=\"space-y-5 mb-10 text-zinc-600 text-sm md:text-base\"><div class=\"flex items-start gap-4\"><div class=\"mt-0.5\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-ticket text-zinc-400\" aria-hidden=\"true\"><path d=\"M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z\"></path><path d=\"M13 5v2\"></path><path d=\"M13 17v2\"></path><path d=\"M13 11v2\"></path></svg></div><p>£1 per ticket entry into the primary draw.</p></div><div class=\"flex items-start gap-4\"><div class=\"mt-0.5\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-calendar text-zinc-400\" aria-hidden=\"true\"><path d=\"M8 2v3\"></path><path d=\"M16 2v3\"></path><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"></rect><path d=\"M3 9h18\"></path></svg></div><p>Add 50p to also enter the Weekly £500 draw.</p></div><div class=\"flex items-start gap-4\"><div class=\"mt-0.5\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-zap text-zinc-400\" aria-hidden=\"true\"><path d=\"M15.914 4a1.5 1.5 0 00-2.474-1.561l-9 9A1.5 1.5 0 005.5 14h4.002a.5.5 0 01.471.666L8.086 20a1.5 1.5 0 002.475 1.56l9-9A1.5 1.5 0 0018.5 10h-3.997a.5.5 0 01-.472-.667z\"></path></svg></div><p>Buy 10 tickets, receive 20. Double your total with Direct Debit.</p></div></div><a class=\"block w-full py-4 px-6 bg-zinc-950 hover:bg-zinc-800 text-white text-center rounded-xl font-medium transition-colors\" href=\"/checkout?type=standard\">Enter Draw</a></div><div class=\"bg-zinc-950 rounded-2xl p-8 md:p-10 border border-zinc-800 shadow-sm relative group hover:border-zinc-700 transition-colors\"><div class=\"absolute top-8 right-8 text-[10px] font-bold uppercase tracking-widest text-zinc-950 bg-white px-3 py-1 rounded-full\">VIP</div><h2 class=\"text-2xl font-serif mb-2 text-white\">High Roller</h2><div class=\"text-5xl font-light tracking-tight mb-8 text-white\">£25,000</div><div class=\"space-y-5 mb-10 text-zinc-400 text-sm md:text-base\"><div class=\"flex items-start gap-4\"><div class=\"mt-0.5\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-ticket text-zinc-600\" aria-hidden=\"true\"><path d=\"M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z\"></path><path d=\"M13 5v2\"></path><path d=\"M13 17v2\"></path><path d=\"M13 11v2\"></path></svg></div><p>£2 per ticket entry into the Bi-Monthly draw.</p></div><div class=\"flex items-start gap-4\"><div class=\"mt-0.5\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-calendar text-zinc-600\" aria-hidden=\"true\"><path d=\"M8 2v3\"></path><path d=\"M16 2v3\"></path><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"></rect><path d=\"M3 9h18\"></path></svg></div><p>Add 50p to also enter the Weekly High Roller (£1,500).</p></div><div class=\"flex items-start gap-4\"><div class=\"mt-0.5\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-zap text-zinc-600\" aria-hidden=\"true\"><path d=\"M15.914 4a1.